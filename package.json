{
  "name": "powergrader-automation",
  "version": "0.1.0",
  "private": true,
  "description": "PowerGrader E2E Automation Framework for LMS Integration Testing",
  "scripts": {
    "test": "playwright test --grep @orchestration",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen",
    "test:canvas": "playwright test --grep '@canvas.*@orchestration'",
    "test:moodle": "playwright test --grep @moodle",
    "test:d2l": "playwright test --grep '@d2l.*@orchestration'",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "dependencies": {
    "@faker-js/faker": "^7.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "allure-playwright": "^2.15.1",
    "dotenv": "^17.2.3",
    "typescript": "^5.3.0"
  }
}
